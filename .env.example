# OmniGuard Backend Environment Configuration
# Copy this to .env and fill in with appropriate values

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/omniguard
DATABASE_SSL=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# REDIS (Cache & Job Queue)
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT CONFIGURATION (CRITICAL - NO DEFAULTS)
# ============================================
# MUST be at least 32 bytes (256 bits) for HS256 algorithm
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-256-bit-secret-here-minimum-32-bytes
JWT_REFRESH_SECRET=your-256-bit-secret-here-minimum-32-bytes

# Issuer and Audience must be explicitly set (no defaults allowed)
JWT_ISSUER=omniguard-api
JWT_AUDIENCE=omniguard-clients

# Token expiration times
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# PASSWORD SECURITY
# ============================================
# bcrypt salt rounds (10-15 recommended, default 12)
BCRYPT_SALT_ROUNDS=12

# ============================================
# EMAIL CONFIGURATION (For verification & password reset)
# ============================================
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@omniguard.example.com
EMAIL_SUPPORT=support@omniguard.example.com

# Email templates (URLs or paths)
EMAIL_VERIFICATION_TEMPLATE=verification-email.html
PASSWORD_RESET_TEMPLATE=password-reset-email.html

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ============================================
# SECURITY
# ============================================
# CORS configuration
CORS_ORIGIN=https://app.omniguard.example.com,https://admin.omniguard.example.com
CORS_CREDENTIALS=true

# Session timeout (milliseconds)
SESSION_TIMEOUT=1800000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CSRF protection (enabled by default)
CSRF_PROTECTION=true

# ============================================
# AUDIT & LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# Audit retention (days)
AUDIT_LOG_RETENTION_DAYS=90

# Token cleanup schedule (cron format)
TOKEN_CLEANUP_SCHEDULE=0 2 * * *
TOKEN_ARCHIVE_SCHEDULE=0 3 * * 0

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_EMAIL_VERIFICATION=true
FEATURE_PASSWORD_RESET=true
FEATURE_RATE_LIMITING=true
FEATURE_ACCOUNT_LOCKOUT=true
FEATURE_TOKEN_ROTATION=true
FEATURE_AUDIT_LOGGING=true

# ============================================
# BLOCKCHAIN (Hyperledger Fabric)
# ============================================
FABRIC_NETWORK_CONFIG=/path/to/network-config.json
FABRIC_USER_ID=app-user
FABRIC_USER_ORG=omniguard-org
FABRIC_CHANNEL_NAME=omniguard-channel
FABRIC_CHAINCODE_NAME=omniguard

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================
# PUF (Physical Unclonable Function) validation
PUF_SERVICE_URL=https://puf-service.example.com
PUF_SERVICE_API_KEY=your-puf-api-key

# Computer Vision validation
CV_SERVICE_URL=https://cv-service.example.com
CV_SERVICE_API_KEY=your-cv-api-key

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

DATADOG_API_KEY=your-datadog-api-key
DATADOG_SITE=datadoghq.com

# ============================================
# DEVELOPMENT ONLY (NEVER USE IN PRODUCTION)
# ============================================
DEBUG=false
SKIP_AUTH_VALIDATION=false
ALLOW_DEFAULT_JWT_SECRETS=false

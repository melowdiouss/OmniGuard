{
  "expo": {
    "name": "OmniGuard Brand",
    "slug": "omniguard-brand",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.ompandeynew.omniguardbrand"
    }
  }
}
